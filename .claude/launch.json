        "STRUCTS_LCD=http://127.0.0.1:31317",
        "RELAY_ALLOW_LOCAL=1",
        "pnpm",
        "exec",
        "vite",
        "--port",
        "5194",
        "--host",
        "127.0.0.1",
        "--strictPort"
      ],
      "port": 5194,
      "url": "http://127.0.0.1:5194"

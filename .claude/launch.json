{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "furrency",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "5193",
        "--strictPort"
      ],
      "port": 5193
    },
    {
      "name": "furrency-devnet",
      "runtimeExecutable": "/usr/bin/env",
